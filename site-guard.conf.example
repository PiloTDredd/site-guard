# site-guard: настройки.
# Файл читают и bash (backup.sh), и Python (monitor.py),
# поэтому формат простой: КЛЮЧ="значение", списки — через пробел.

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather и ID чата, куда слать уведомления.
TG_BOT_TOKEN=""
TG_CHAT_ID=""
# Как подписывать сообщения (удобно, если серверов несколько).
SERVER_NAME="my-vps"

# --- Мониторинг -------------------------------------------------------------
# Какие адреса проверять (через пробел).
SITES="https://example.com"
# Сколько секунд ждать ответа сайта.
HTTP_TIMEOUT=15
# Сколько проверок подряд должно провалиться, чтобы прислать «сайт упал».
# 2 проверки = ~10 минут, защищает от ложных тревог при секундных сбоях.
FAILS_BEFORE_ALERT=2
# За сколько дней до окончания SSL-сертификата предупреждать.
SSL_WARN_DAYS=14
# При каком заполнении диска (в процентах) предупреждать.
DISK_WARN_PERCENT=90
# Какие разделы проверять.
DISK_PATHS="/"
# Через сколько часов без успешного бэкапа считать, что бэкап сломался.
BACKUP_MAX_AGE_HOURS=26

# --- Бэкап ------------------------------------------------------------------
# Куда складывать копии на этом сервере.
BACKUP_DIR="/var/backups/site-guard"
# Сколько дней хранить копии.
BACKUP_KEEP_DAYS=7
# Папки сайтов, которые нужно копировать (через пробел).
SITE_DIRS="/var/www/example.com"
# База данных: mysql | postgres | none
DB_TYPE="mysql"
# Имена баз через пробел.
DB_NAMES="example_db"
# Для mysql используются учётные данные root (сокет) или /root/.my.cnf.
# Для postgres дамп делается от пользователя postgres.

# Копировать бэкапы на другой сервер по rsync+ssh (вход по ключу).
# Пример: backup@203.0.113.10:/backups/my-vps   Пусто — не копировать.
REMOTE_TARGET=""

# Присылать сообщение и об успешном бэкапе (yes/no).
NOTIFY_BACKUP_OK="no"

# --- Служебное --------------------------------------------------------------
# Где хранить состояние между проверками.
STATE_DIR="/var/lib/site-guard"
